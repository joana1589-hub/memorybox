rules_version = '2';
// Copiar para: Firebase Console → Firestore Database → Regras → Publicar
// Os emails têm de ser os mesmos que estão em EMAILS no index.html
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'joana1589@gmail.com',
             'elineas_@hotmail.com',
             'elianasantosphotography@gmail.com'
           ];
    }
    match /memorybox/v1 {
      allow read, write: if autorizado();

      // Histórico: só se pode acrescentar, nunca alterar nem apagar,
      // e cada registo tem de ficar com o email de quem o fez.
      match /historico/{id} {
        allow read: if autorizado();
        allow create: if autorizado()
          && request.resource.data.email == request.auth.token.email.lower();
        allow update, delete: if false;
      }

      match /{colecao}/{id} {
        allow read, write: if autorizado() && colecao != 'historico';
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
